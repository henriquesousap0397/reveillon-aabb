{
  // Configuração do Cloudflare.
  // - Publica só a pasta public/ (o site e o painel). README e este arquivo não vão para o ar.
  // - src/worker.js responde em /api/estatisticas com os números do painel (/painel/).
  // - /api/mesas e /api/admin/* usam o Durable Object "Mesas" (reservas de mesas, sem precisar ativar nada no painel).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reveillon",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [{ "name": "MESAS", "class_name": "Mesas" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Mesas"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
